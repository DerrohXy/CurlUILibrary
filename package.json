        "./icons/go": "./dist/icons/go/index.js",
        "./icons/gr": "./dist/icons/gr/index.js",
        "./icons/hi": "./dist/icons/hi/index.js",
        "./icons/hi2": "./dist/icons/hi2/index.js",
        "./icons/im": "./dist/icons/im/index.js",
