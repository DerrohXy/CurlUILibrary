    "sideEffects": false,
    "scripts": {
        "rollup": "rollup --config --bundleConfigAsCjs",
        "rollup-watch": "rollup -w --config --bundleConfigAsCjs",
        "build": "tsc && npm run rollup && ./post-build.sh",
        "build:watch": "tsc && npm run rollup-watch && ./post-build.sh",
        "build:analyze": "tsc && npm run rollup && ./postbuild.sh && npx rollup-plugin-visualizer dist/stats.html",
        "size": "npm run build && npx size-limit"
    },
    "files": [
        "dist"
    ],
    "keywords": [],
    "author": "",
    "license": "MIT",
    "peerDependencies": {
        "curlui": "^0.0.5"
    },
    "devDependencies": {
        "@rollup/plugin-commonjs": "^28.0.1",
