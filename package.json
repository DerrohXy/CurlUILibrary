        "./icons/md": "./dist/icons/md/index.js",
        "./icons/pi": "./dist/icons/pi/index.js",
        "./icons/ri": "./dist/icons/ri/index.js",
        "./icons/rx": "./dist/icons/rx/index.js",
        "./icons/si": "./dist/icons/si/index.js",
        "./icons/sl": "./dist/icons/sl/index.js",
        "./icons/tb": "./dist/icons/tb/index.js",
        "./icons/tfi": "./dist/icons/tfi/index.js",
        "./icons/ti": "./dist/icons/ti/index.js",
        "./icons/vsc": "./dist/icons/vsc/index.js",
        "./icons/wi": "./dist/icons/wi/index.js"
