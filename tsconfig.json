{
    "compilerOptions": {
        "outDir": "./dist",
        "target": "ES2017",
        "module": "NodeNext",
        "lib": ["DOM", "ESNext"],
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "sourceMap": true,
        "moduleResolution": "nodenext",
        "jsx": "react-jsx",
        "jsxImportSource": "curlui"
    },
    "include": ["src"]
}
